.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.article-header {
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.back-btn {
  font-size: 48rpx;
  color: #1A1D23;
  font-weight: 300;
}

.header-title {
  flex: 1;
  font-size: 32rpx;
  color: #1A1D23;
  font-weight: 600;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.action-btn {
  font-size: 32rpx;
}

.article-content {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

.article-title {
  font-size: 40rpx;
  color: #1A1D23;
  font-weight: bold;
  line-height: 1.4;
  display: block;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #6B7280;
}

.article-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.paragraph {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.8;
}

.heading {
  font-size: 32rpx;
  color: #1A1D23;
  font-weight: bold;
  margin-top: 16rpx;
}

.list-item {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.8;
  padding-left: 16rpx;
}

.code-block {
  background-color: #1E293B;
  border-radius: 16rpx;
  padding: 24rpx;
  overflow-x: auto;
}

.code-line {
  font-size: 24rpx;
  color: #E2E8F0;
  font-family: monospace;
  display: block;
  line-height: 1.6;
}

.summary-box {
  background-color: rgba(59, 111, 224, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.summary-title {
  font-size: 28rpx;
  color: #3B6FE0;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.summary-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

.article-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.article-footer-spacer {
  height: 120rpx;
}

.footer-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 0 20rpx;
}

.footer-btn text:first-child {
  font-size: 32rpx;
}

.footer-btn text:last-child {
  font-size: 22rpx;
  color: #6B7280;
}

.footer-action-btn {
  flex: 1;
  background-color: #3B6FE0;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  padding: 20rpx;
  border-radius: 40rpx;
}