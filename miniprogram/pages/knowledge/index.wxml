<view class="page-container">
  <view class="search-bar" bindtap="goToSearch">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索文章、知识点...</text>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">📚 知识分类</text>
    </view>
    <view class="category-list">
      <view class="category-item" wx:for="{{categories}}" wx:key="id">
        <view class="category-header" data-id="{{item.id}}" bindtap="toggleCategory">
          <view class="category-left">
            <view class="category-icon" style="background-color: {{item.bgColor}};">
              <text>{{item.icon}}</text>
            </view>
            <view class="category-info">
              <text class="category-name">{{item.name}}</text>
              <text class="category-count">{{item.count}} 篇文章</text>
            </view>
          </view>
          <text class="expand-icon">{{item.expanded ? '▼' : '▶'}}</text>
        </view>
        <view class="subcategory-list" wx:if="{{item.expanded}}">
          <view class="subcategory-item" wx:for="{{item.children}}" wx:for-key="id" wx:for-item="child" data-id="{{child.id}}" bindtap="goToArticle">
            <text class="subcategory-name">{{child.name}}</text>
            <text class="subcategory-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">📖 最近阅读</text>
      <view class="section-more" bindtap="goToAllArticles">
        <text class="more-text">全部</text>
        <text class="more-icon">›</text>
      </view>
    </view>
    <view class="recent-list">
      <view class="recent-item" wx:for="{{recentReadings}}" wx:key="id" data-id="{{item.id}}" bindtap="goToArticleDetail">
        <view class="recent-icon">{{item.icon}}</view>
        <view class="recent-content">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-meta">{{item.category}} · {{item.time}}</text>
        </view>
        <view class="recent-progress">
          <text class="progress-text">{{item.progress}}%</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">⭐ 推荐阅读</text>
    </view>
    <view class="recommend-list">
      <view class="recommend-card" wx:for="{{recommendations}}" wx:key="id" data-id="{{item.id}}" bindtap="goToArticleDetail">
        <view class="recommend-header">
          <text class="recommend-tag" style="background-color: {{item.tagBg}}; color: {{item.tagColor}};">{{item.tag}}</text>
        </view>
        <text class="recommend-title">{{item.title}}</text>
        <text class="recommend-desc">{{item.desc}}</text>
        <view class="recommend-footer">
          <text class="recommend-author">{{item.author}}</text>
          <text class="recommend-views">{{item.views}} 阅读</text>
        </view>
      </view>
    </view>
  </view>
</view>