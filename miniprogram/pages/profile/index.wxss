.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

.profile-header {
  background: linear-gradient(135deg, #3B6FE0 0%, #5B8FE8 100%);
  border-radius: 0 0 32rpx 32rpx;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  background-color: rgba(255,255,255,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.username {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-top: 20rpx;
}

.level-badge {
  background-color: rgba(255,255,255,0.2);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.level-badge text {
  font-size: 24rpx;
  color: #FFFFFF;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  margin-top: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-value {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
}

.stat-divider {
  width: 2rpx;
  height: 64rpx;
  background-color: rgba(255,255,255,0.2);
}

.level-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

.level-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.level-title {
  font-size: 30rpx;
  color: #1A1D23;
  font-weight: 600;
}

.level-xp {
  font-size: 24rpx;
  color: #3B6FE0;
  font-weight: 500;
}

.level-progress-bar {
  height: 16rpx;
  background-color: #E8ECF1;
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 24rpx;
}

.level-progress-fill {
  height: 100%;
  width: 81.7%;
  background-color: #3B6FE0;
  border-radius: 999rpx;
}

.level-labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.level-labels text {
  font-size: 24rpx;
  color: #6B7280;
}

.achievements-section {
  margin: 0 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

.achievements-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.achievements-title {
  font-size: 30rpx;
  color: #1A1D23;
  font-weight: 600;
}

.achievements-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.achievements-more text {
  font-size: 26rpx;
  color: #3B6FE0;
}

.badges-scroll {
  white-space: nowrap;
  margin-top: 24rpx;
}

.badges-list {
  display: flex;
  gap: 32rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.badge-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.badge-name {
  font-size: 22rpx;
}

.menu-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1A1D23;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #6B7280;
}

.menu-divider {
  height: 1rpx;
  background-color: #E2E6EC;
  margin: 0 32rpx;
}

.toggle-switch {
  margin-left: auto;
}

.toggle-track {
  width: 72rpx;
  height: 40rpx;
  background-color: #E8ECF1;
  border-radius: 999rpx;
  padding: 4rpx;
}

.toggle-thumb {
  width: 32rpx;
  height: 32rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
}