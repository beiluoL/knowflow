.page-container {
  min-height: 100vh;
  background-color: #F7F8FA;
}

.search-header {
  background-color: #FFFFFF;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #F2F3F5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1D23;
}

.clear-btn {
  font-size: 24rpx;
  color: #6B7280;
}

.cancel-btn {
  font-size: 30rpx;
  color: #3B6FE0;
  font-weight: 500;
}

.search-content {
  padding: 24rpx 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #1A1D23;
  font-weight: 600;
}

.refresh-btn {
  font-size: 26rpx;
  color: #6B7280;
}

.hot-tags, .history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  padding: 16rpx 28rpx;
  background-color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1A1D23;
}

.history-tag {
  padding: 16rpx 28rpx;
  background-color: #F2F3F5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.results-count {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 20rpx;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
}

.result-title {
  font-size: 30rpx;
  color: #1A1D23;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.result-summary {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.result-category {
  font-size: 22rpx;
  color: #3B6FE0;
  padding: 6rpx 16rpx;
  background-color: rgba(59, 111, 224, 0.1);
  border-radius: 12rpx;
}

.result-time {
  font-size: 22rpx;
  color: #6B7280;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #1A1D23;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #6B7280;
}