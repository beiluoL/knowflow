<cover-view class="tab-bar">
  <cover-view class="tab-bar-item" wx:for="{{list}}" wx:key="index" data-index="{{index}}" bindtap="switchTab">
    <cover-view class="tab-icon">{{item.icon}}</cover-view>
    <cover-view class="tab-text {{selected === index ? 'active' : ''}}">{{item.text}}</cover-view>
  </cover-view>
</cover-view>
